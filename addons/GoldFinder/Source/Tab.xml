<Ui xmlns="http://www.blizzard.com/wow/ui/">
  <!--
    Template + anchor pattern taken from Collectionator's
    Source/Summary/Tab/Main.xml (github.com/TheMouseNest/Collectionator, MIT),
    the closest available same-author reference for adding a tab to Auctionator.
    NOT yet confirmed against the Classic Era (LegacyAH) build — see AGENTS.md.
  -->
  <Frame
    name="GoldFinderTabFrameTemplate"
    mixin="GoldFinderTabFrameMixin"
    virtual="true"
    parentKey="GoldFinderTabFrame"
    hidden="true"
  >
    <Anchors>
      <Anchor point="TOP" relativeKey="$parent.CategoriesList" relativePoint="TOP"/>
      <Anchor point="LEFT" x="4"/>
      <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT" x="-4" y="27"/>
    </Anchors>
    <Scripts>
      <OnLoad method="OnLoad"/>
      <OnShow method="OnShow"/>
    </Scripts>
    <Layers>
      <Layer level="ARTWORK">
        <FontString parentKey="PlaceholderText" inherits="GameFontHighlight">
          <Anchors>
            <Anchor point="TOPLEFT" x="8" y="-8"/>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
  </Frame>
</Ui>
